{
  "page": "IndustryFaqPage",
  "route": "/",
  "dataSources": [
    {
      "name": "mockFaqItemsData",
      "shape": "array",
      "endpoint": { "method": "GET", "path": "/api/industry-scenario/faqs" },
      "queryParams": ["keyword", "status"]
    },
    {
      "name": "mockFaqSourceItemsData",
      "shape": "array",
      "endpoint": { "method": "GET", "path": "/api/industry-scenario/faq-sources" },
      "queryParams": ["menu"]
    }
  ],
  "actions": [
    { "handler": "handleFetchFaqItems", "endpoint": { "method": "GET", "path": "/api/industry-scenario/faqs" }, "requestFrom": "param", "responseShape": "array" },
    { "handler": "handleFetchFaqSources", "endpoint": { "method": "GET", "path": "/api/industry-scenario/faq-sources" }, "requestFrom": "param", "responseShape": "array" },
    { "handler": "handlePreviewGeneratedFaq", "endpoint": { "method": "POST", "path": "/api/industry-scenario/faqs/ai-preview" }, "requestFrom": "body", "responseShape": "array" },
    { "handler": "handleCreateFaqItems", "endpoint": { "method": "POST", "path": "/api/industry-scenario/faqs/batch" }, "requestFrom": "body", "responseShape": "array" },
    { "handler": "handleUpdateFaqItem", "endpoint": { "method": "PATCH", "path": "/api/industry-scenario/faqs/{id}" }, "requestFrom": "body", "responseShape": "object" },
    { "handler": "handlePublishFaqItem", "endpoint": { "method": "PATCH", "path": "/api/industry-scenario/faqs/{id}/publish" }, "requestFrom": "param", "responseShape": "object" },
    { "handler": "handleDeleteFaqItem", "endpoint": { "method": "DELETE", "path": "/api/industry-scenario/faqs/{id}" }, "requestFrom": "param", "responseShape": "none" }
  ]
}
